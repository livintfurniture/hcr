{
  "name": "worlds-tours-and-travels",
  "version": "1.0.0",
  "description": "Production website for Worlds Tours and Travels — Cab & Tour services.",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --watch",
    "icons": "node tools/generate-icons.js",
    "og-image": "node tools/generate-og-image.js",
    "serve": "npx --yes http-server -p 8080 -c-1"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13"
  }
}
